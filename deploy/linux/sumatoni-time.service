[Unit]
Description=Sumatoni Time
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=sumatoni-time
Group=sumatoni-time
WorkingDirectory=/opt/sumatoni-time/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/etc/sumatoni-time/sumatoni.env
ExecStart=/usr/local/bin/node /opt/sumatoni-time/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 5173
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sumatoni-time /var/cache/sumatoni-time
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=multi-user.target
