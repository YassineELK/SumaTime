# SumaTime access logs deliberately omit query parameters and Referer.
log_format sumatoni_time '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

# Replace the hostname and install the chosen certificate before enabling this site.
# A self-signed certificate requires explicit trust on each client device.
# The application source and database are never served as static directories.
server {
    listen 80;
    listen [::]:80;
    server_name sumatime.home.sumatoni.be;
    access_log /var/log/nginx/sumatoni-time-access.log sumatoni_time;
    return 308 https://sumatime.home.sumatoni.be$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name sumatime.home.sumatoni.be;
    access_log /var/log/nginx/sumatoni-time-access.log sumatoni_time;
    ssl_certificate /etc/sumatoni-time/tls/fullchain.pem;
    ssl_certificate_key /etc/sumatoni-time/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SumatoniTLS:10m;
    ssl_session_timeout 1d;
    server_tokens off;
    client_max_body_size 1m;
    client_body_timeout 15s;
    keepalive_timeout 30s;

    location ~ /\. { return 404; }
    location / {
        proxy_pass http://127.0.0.1:5173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
        proxy_no_cache 1;
    }
}
