# Copy to .env.local. Never commit credentials.
APP_URL=http://127.0.0.1:5173
DATABASE_PATH=data/timesheet.sqlite
# Optional GLPI legacy REST API (v1). Each member connects a personal user token.
# GLPI_API_URL=https://glpi.example.internal/apirest.php
# GLPI_APP_TOKEN=
# First install: a random code is generated in data/setup-token.txt.
# SETUP_TOKEN=long-random-installation-code

LDAP_ENABLED=false
LDAP_URL=ldaps://dc01.example.internal:636
LDAP_STARTTLS=false
LDAP_BASE_DN=DC=example,DC=internal
LDAP_BIND_DN=CN=svc-timesheet,OU=Services,DC=example,DC=internal
LDAP_BIND_PASSWORD=
# Restrict access to an AD group with an additional memberOf clause if desired.
LDAP_USER_FILTER=(sAMAccountName={{username}})
# For OpenLDAP, for example: (uid={{username}})
# Internal CA in PEM format; certificate validation always stays enabled.
# LDAP_CA_FILE=C:/SumatoniTime/certificates/root-ca.pem

# Création GLPI : activer explicitement après validation de votre configuration.
GLPI_WRITE_ENABLED=false
